// ユーザーレベルのタスク（Tasks: Open User Tasks で開くファイル）
{
  "version": "2.0.0",
  "tasks": [
    {
      // 選択なし用。${selectedText} は選択がないと解決できずタスクごと失敗するので、こちらでは使わない
      "label": "ghlink",
      "detail": "カーソル行の GitHub permalink をコピーする",
      "type": "shell",
      "command": "bash",
      "args": [
        "${userHome}/dotfiles/vscode/github-permalink.sh",
        "${file}:${lineNumber}"
      ],
      "problemMatcher": [],
      // 出力は専用ターミナルに溜める。前面には出さず、見たいときだけターミナルの一覧から開く
      "presentation": {
        "reveal": "never",
        "focus": false,
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      // 選択あり用。選択テキストの行数から範囲を割り出すために ${selectedText} を渡す
      "label": "ghlink-selection",
      "detail": "選択範囲の GitHub permalink をコピーする",
      "type": "shell",
      "command": "bash",
      "args": [
        "${userHome}/dotfiles/vscode/github-permalink.sh",
        "${file}:${lineNumber}"
      ],
      "options": {
        "env": {
          "GHLINK_SELECTION": "${selectedText}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      // 行番号なし用。ファイル全体を指すリンクを作る
      "label": "ghlink-file",
      "detail": "ファイル全体の GitHub permalink をコピーする",
      "type": "shell",
      "command": "bash",
      "args": [
        "${userHome}/dotfiles/vscode/github-permalink.sh",
        "${file}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      // 「~/ から始まるパス:行番号」をコピーする。パスに記号が入っていても壊れないよう、環境変数で渡す
      "label": "copy-path-with-line",
      "detail": "カーソル行の ~/パス:行番号 をコピーする",
      "type": "shell",
      "command": "p=\"$COPY_FILE\"; case \"$p\" in \"$HOME\"/*) p=\"~${p#\"$HOME\"}\" ;; esac; printf '%s:%s' \"$p\" \"$COPY_LINE\" | pbcopy",
      "options": {
        "env": {
          "COPY_FILE": "${file}",
          "COPY_LINE": "${lineNumber}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      // ghlink と同じリンクをコピーし、ブラウザでも開く
      "label": "ghlink-open",
      "detail": "カーソル行の GitHub permalink をコピーしてブラウザで開く",
      "type": "shell",
      "command": "bash",
      "args": [
        "${userHome}/dotfiles/vscode/github-permalink.sh",
        "${file}:${lineNumber}"
      ],
      "options": {
        "env": {
          "GHLINK_OPEN": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      // ghlink-selection と同じリンクをコピーし、ブラウザでも開く
      "label": "ghlink-selection-open",
      "detail": "選択範囲の GitHub permalink をコピーしてブラウザで開く",
      "type": "shell",
      "command": "bash",
      "args": [
        "${userHome}/dotfiles/vscode/github-permalink.sh",
        "${file}:${lineNumber}"
      ],
      "options": {
        "env": {
          "GHLINK_SELECTION": "${selectedText}",
          "GHLINK_OPEN": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "focus": false,
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    }
  ]
}
