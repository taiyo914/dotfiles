# ユーザー名・メールアドレス・署名設定などは ~/dotfiles-local/git/local.config にかく
# ~/.config/git は比較的モダンな置き場所で、もし従来の
# ~/.gitconfig が残っていると、こちらが優先されるため注意

[core]
	editor = code -w
    # pager = delta 
	quotePath = false

[alias]
    st = status
    aa = add .
    ci = commit
    br = branch
    co = checkout
    sw = switch
    rs = restore
    df = diff
    unstage = restore --staged
    amend = commit --amend
    cstash = stash push -u -m
    stls = stash list
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
    sweep = !git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -d

[url "ssh://git@github.com"]
  insteadOf = https://github.com

# [interactive]
#     diffFilter = delta --color-only

# [delta]
#     navigate = true
#     line-numbers = true

[merge]
    conflictstyle = zdiff3

# このマシンだけで必要な設定を読み込む
[include]
	path = ~/dotfiles-local/git/local.config

[fetch]
    prune = true