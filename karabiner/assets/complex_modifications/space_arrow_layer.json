{
  "title": "Space Arrow Layer",
  "rules": [
    {
      "description": "Space 長押しで矢印レイヤー",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "space_layer",
                "value": 1
              }
            },
            {
              "set_variable": {
                "name": "space_used",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "space_down_ms",
                "expression": "system.now.milliseconds"
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "space_layer",
                "value": 0
              }
            },
            {
              "key_code": "spacebar",
              "conditions": [
                {
                  "type": "variable_if",
                  "name": "space_used",
                  "value": 0
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "any": "key_code",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "spacebar"
            },
            {
              "set_variable": {
                "name": "space_layer",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "space_used",
                "value": 1
              }
            },
            {
              "from_event": true
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "space_layer",
              "value": 1
            },
            {
              "type": "expression_if",
              "expression": "system.now.milliseconds - space_down_ms < 150"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "space_used",
                "value": 1
              }
            },
            {
              "key_code": "left_arrow"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "space_layer",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
