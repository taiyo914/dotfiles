{
  "manifest_version": 3,
  "name": "AI Chat Tab Send",
  "version": "0.1.0",
  "description": "claude.ai / Gemini / ChatGPT の入力欄で、Enter を改行、Tab を送信にする",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
