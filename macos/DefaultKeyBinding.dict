/* macOS の Emacs 風キーバインドを無効にする
 *
 * 定義元 : /System/Library/Frameworks/AppKit.framework/Resources/StandardKeyBinding.dict
 * このファイルが上書きする。"noop:" は「何もしない」の意味。
 *
 * 記号 : ^ = Control / ~ = Option / $ = Shift / @ = Command
 * 大文字 ("^A" など) は Control + Shift の組み合わせ。
 *
 * 反映にはアプリの再起動（確実にやるならログインし直し）が必要。
 */
{
    "^a" = "noop:";  /* 行頭へ移動 */
    "^A" = "noop:";  /* 行頭まで選択 */
    "^b" = "noop:";  /* 1文字 左へ移動 */
    "^B" = "noop:";  /* 1文字 左を選択 */
    "^d" = "noop:";  /* カーソルの右を1文字削除 */
    "^e" = "noop:";  /* 行末へ移動 */
    "^E" = "noop:";  /* 行末まで選択 */
    "^f" = "noop:";  /* 1文字 右へ移動 */
    "^F" = "noop:";  /* 1文字 右を選択 */
    "^h" = "noop:";  /* カーソルの左を1文字削除 */
    "^k" = "noop:";  /* カーソルから行末まで削除 */
    "^l" = "noop:";  /* カーソル位置を画面の中央へスクロール */
    "^n" = "noop:";  /* 1行 下へ移動 */
    "^N" = "noop:";  /* 1行 下まで選択 */
    "^o" = "noop:";  /* 改行を挿入してカーソルは動かさない */
    "^p" = "noop:";  /* 1行 上へ移動 */
    "^P" = "noop:";  /* 1行 上まで選択 */
    "^t" = "noop:";  /* 前後の文字を入れ替え */
    "^v" = "noop:";  /* 1画面ぶん下へスクロール */
    "^V" = "noop:";  /* 1画面ぶん下まで選択 */
    "^y" = "noop:";  /* ^k で消した文字を貼り付け */
}
