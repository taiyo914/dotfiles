# 見た目
theme = "Catppuccin Mocha"
# font-family = JetBrains Mono
# font-family = BIZ UDGothic
font-feature = -calt, -liga, -dlig
font-size = 16
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95

# 操作性
window-save-state = always
scrollback-limit = 100000000
window-inherit-working-directory = false
mouse-hide-while-typing = true

# タブ・ペイン・space の操作はすべて Ghostty では無効にして herdr に渡す
# 割り当ては herdr/config.toml を参照する
# hint: Ghostty の window 用のキーは herdr の space の操作に使う

# ペイン
# cmd+d=右に分割 / cmd+shift+d=下に分割 / cmd+w=ペインを閉じる
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+w=unbind
# cmd+] / cmd+[ = 次 / 前のペインへ移動
keybind = cmd+[=unbind
keybind = cmd+]=unbind
# cmd+alt+矢印 = 矢印の方向のペインへ移動
keybind = cmd+alt+arrow_left=unbind
keybind = cmd+alt+arrow_down=unbind
keybind = cmd+alt+arrow_up=unbind
keybind = cmd+alt+arrow_right=unbind
# cmd+ctrl+矢印 = ペインの大きさを変える
keybind = cmd+ctrl+arrow_left=unbind
keybind = cmd+ctrl+arrow_down=unbind
keybind = cmd+ctrl+arrow_up=unbind
keybind = cmd+ctrl+arrow_right=unbind
# cmd+shift+enter = ペインを全画面にする / 戻す
keybind = cmd+shift+enter=unbind

# タブ
# cmd+t=タブ作成 / cmd+alt+w=タブを閉じる / cmd+shift+t=タブの名前を変える
keybind = cmd+t=unbind
keybind = cmd+alt+w=unbind
keybind = cmd+shift+t=unbind
# cmd+shift+] / cmd+shift+[ = 次 / 前のタブへ移動
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
# cmd+1〜9 = 番号のタブへ移動
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind

# space
# cmd+n=space作成 / cmd+shift+w=spaceを閉じる / cmd+b=サイドバーの開閉
keybind = cmd+n=unbind
keybind = cmd+shift+w=unbind
keybind = cmd+b=unbind

# 以下は Ghostty に割り当てがないので unbind しなくても herdr に届く
# cmd+shift+n = space の名前を変える
# cmd+` / cmd+shift+` = 次 / 前の space へ移動
# ctrl+1〜9 = 番号の space へ移動

# ctrl+tab / ctrl+shift+tab = 次 / 前のタブへ移動
# これらだけは unbind が効かないので工夫が必要
# これらは macOS が「Show Next/Previous Tab」としてもっているので、 Ghostty 側で無効化しても macOS で反応してしまう
# なので、こいつらは Ghostty で先に奪い取って、次の意味のない操作で素通りさせて herdr へ届ける
# - show_gtk_inspector は Linux 版だけのアクションなので macOS では何も起きない
# - unconsumed: は「アクションを実行したうえでキーも中のアプリに送る」という意味
# 参考: https://github.com/ghostty-org/ghostty/discussions/7013
keybind = unconsumed:ctrl+tab=show_gtk_inspector
keybind = unconsumed:shift+ctrl+tab=show_gtk_inspector

macos-titlebar-style = native

# もしかしたらこれで「の」が楷書になる現象が直るかも
font-codepoint-map = U+3000-U+30FF,U+4E00-U+9FFF=BIZ UDGothic

# スクロールしたときの動く量を何倍にするか
# precison （精密さ） はトラックパッドなど連続的なスクロール - デフォルト値は 1
# discrete (離散的な) はマウスなどの離散的なスクロール - デフォルト値は 3 
# 既定値の 3 だと分割キーボードでスクロールが大きくなりすぎるので 1 にする
mouse-scroll-multiplier = discrete:1
