// Zellij はフローティングペインだけに使い、ほかのキーはすべて中のアプリに送る
// Ghostty の起動時に読み込まれる（ghostty/config の command を参照）

keybinds clear-defaults=true {
    shared {
        bind "Alt f" { ToggleFloatingPanes; }
    }
}

pane_frames false
show_startup_tips false
show_release_notes false

// Ghostty のウィンドウを閉じたら、セッションを裏に残さず終了する
on_force_close "quit"
